# Copie para .env e preencha. O .env NUNCA vai para o git e o agente NÃO o lê
# (bloqueado em .claude/settings.json). Credencial chega ao teste só por
# credenciaisDe(perfil), em tempo de execução.

# ─── ClickUp ─────────────────────────────────────────────────────────────
# Usado pelo MCP local do .mcp.json e conferido pelo `npm run doctor`.
# O conector ClickUp do claude.ai não depende destas variáveis.
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_MCP_LICENSE_KEY=

# ─── Credenciais por cliente / sistema / perfil ──────────────────────────
# Padrão: <CLIENTE>_<SISTEMA>_<PERFIL>_USER / _PASS
# Maiúsculas; `-` e qualquer caractere fora de A-Z0-9 vira `_`.
# Um par por perfil listado em config/clientes.json → sistemas.<id>.perfis.
ACME_CRM_ADMIN_USER=
ACME_CRM_ADMIN_PASS=
ACME_CRM_OPERADOR_USER=
ACME_CRM_OPERADOR_PASS=

# ─── Banco de homologação (opcional, só leitura) ─────────────────────────
# Padrão: <CLIENTE>_<SISTEMA>_DB_USER / _DB_PASS. Servidor e database ficam
# em config/clientes.json → sistemas.<id>.db.
ACME_CRM_DB_USER=
ACME_CRM_DB_PASS=
