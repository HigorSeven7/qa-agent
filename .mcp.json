{
  "mcpServers": {
    "ClickUp": {
      "command": "npx",
      "args": ["-y", "@taazkareem/clickup-mcp-server@latest"],
      "env": {
        "CLICKUP_API_KEY": "${CLICKUP_API_TOKEN}",
        "CLICKUP_TEAM_ID": "${CLICKUP_TEAM_ID}",
        "CLICKUP_MCP_LICENSE_KEY": "${CLICKUP_MCP_LICENSE_KEY}"
      }
    }
  }
}
